# Copy this file to .env (same folder) and fill in what you need. .env is never committed.

# Claude API key for the Plan Assistant (free-form chat). Without it, the assistant
# uses the built-in parser for clear commands. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional overrides for the demo accounts and secrets
# ADMIN_PASSWORD=
# FACULTY_PASSWORD=
# STUDENT_PASSWORD=
# JWT_SECRET=
# TICKET_SECRET=
