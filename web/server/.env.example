# Copy this file to .env (same folder) and fill in what you need. .env is never committed.

# --- Plan Assistant LLM -------------------------------------------------------
# Free option: Google Gemini. Create a key at https://aistudio.google.com/apikey
# (free tier; Google may use free-tier prompts to improve its products).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Paid option: Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# With both keys set, Gemini is used. Force one with: gemini | claude | parser
# ASSISTANT_PROVIDER=

# --- Optional overrides for the demo accounts and secrets ---------------------
# ADMIN_PASSWORD=
# FACULTY_PASSWORD=
# STUDENT_PASSWORD=
# JWT_SECRET=
# TICKET_SECRET=
