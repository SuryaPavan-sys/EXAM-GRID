# Copy this file to .env (same folder) and fill in what you need. .env is never committed.

# --- Plan Assistant LLM -------------------------------------------------------
# Each message goes to Claude first; if Claude fails (or has no key) Gemini answers;
# if neither can, the built-in parser handles clear commands.

# Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Google Gemini, free tier: https://aistudio.google.com/apikey
# (Google may use free-tier prompts to improve its products.)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Put one provider first: claude | gemini | parser
# ASSISTANT_PROVIDER=

# --- Optional overrides for the demo accounts and secrets ---------------------
# ADMIN_PASSWORD=
# FACULTY_PASSWORD=
# STUDENT_PASSWORD=
# JWT_SECRET=
# TICKET_SECRET=
